generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String   @unique
  createdAt DateTime @default(now())

  orders    Order[]
}

model Order {
  id          Int      @id @default(autoincrement())
  customerId  Int
  quantity    Int
  unitPrice   Float
  totalAmount Float
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])
}